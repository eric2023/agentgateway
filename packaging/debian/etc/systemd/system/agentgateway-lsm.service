[Unit]
Description=AgentGateway BPF-LSM enforcement sandbox (方案B)
After=network.target

[Service]
Type=simple
ExecStartPre=-/bin/rm -rf /sys/fs/bpf/agentgateway
ExecStart=/usr/lib/agentgateway/bpf/agent_lsm
Restart=on-failure
Environment=AGW_ENFORCE_FILE_WRITE=0
Environment=AGW_WRITE_ALLOW=/tmp

[Install]
WantedBy=multi-user.target
