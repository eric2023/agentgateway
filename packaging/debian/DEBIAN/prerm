#!/bin/sh
# AgentGateway BPF 组件卸载前脚本
set -e

systemctl stop agentgateway-lsm.service agentgateway-audit.service \
    agentgateway-tproxy.service agentgateway-uprobe.service \
    agentgateway-uprobe-consumer.service 2>/dev/null || true
systemctl disable agentgateway-lsm.service agentgateway-audit.service \
    agentgateway-tproxy.service agentgateway-uprobe.service \
    agentgateway-uprobe-consumer.service 2>/dev/null || true

# 清理 nftables 规则
nft delete table inet agentgateway 2>/dev/null || true

# 移除系统级 CA
rm -f /etc/ssl/certs/agentgateway-ca.pem
update-ca-certificates || true

exit 0
