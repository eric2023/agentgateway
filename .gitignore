# Certificates (runtime-generated, contains private keys — never track)
/certs/

# Logs
logs/

# Audit data (runtime-generated, may contain sensitive content)
audit/audit.jsonl
audit/audit-tls.jsonl
audit/audit.db
audit/audit.db-shm
audit/audit.db-wal

# Python
*.pyc
__pycache__/

# BPF build artifacts (regenerated via `make -C bpf`)
bpf/vmlinux.h
bpf/*.o
bpf/*.skel.h
bpf/agent_lsm
bpf/audit_consumer
bpf/cgroupid
bpf/agent_admit
bpf/agent_landlock
bpf/agent_uprobe
bpf/agent_uprobe_consumer
bpf/seccomp_confirm

# OS files
.DS_Store
*.swp
*~

# Distribution / packaging artifacts (generated, not tracked)
/dist/
/packaging/

# Added by cargo

/target
