# Runtime-generated files (not tracked)
certs/dyn-*
certs/*-key.pem
certs/ca-key.pem
certs/ca-cert.pem

# Logs
logs/

# Audit data (runtime-generated, may contain sensitive content)
audit/audit.jsonl
audit/audit-tls.jsonl
audit/audit.db
audit/audit.db-shm
audit/audit.db-wal

# Python
*.pyc
__pycache__/

# BPF build artifacts (regenerated via `make -C bpf`)
bpf/vmlinux.h
bpf/*.o
bpf/*.skel.h
bpf/agent_lsm
bpf/audit_consumer
bpf/cgroupid
bpf/agent_admit
bpf/agent_landlock
bpf/agent_uprobe
bpf/agent_uprobe_consumer
bpf/seccomp_confirm

# OS files
.DS_Store
*.swp
*~


# Added by cargo

/target
