# Runtime-generated files (not tracked)
certs/dyn-*
certs/*-key.pem
certs/ca-key.pem
certs/ca-cert.pem

# Logs
logs/

# DEB package output
dist/
packaging/debian/usr/

# Audit data (runtime-generated, may contain sensitive content)
audit/audit.jsonl
audit/audit-tls.jsonl
audit/test_report.md

# Compiled artifacts (rebuilt from source)
gateway/libauditshim.so
*.pyc
__pycache__/

# BPF build artifacts (regenerated via `make -C bpf`)
bpf/vmlinux.h
bpf/*.o
bpf/*.skel.h
bpf/agent_lsm
bpf/audit_consumer
bpf/cgroupid
bpf/agent_admit
bpf/agent_landlock
bpf/agent_uprobe
bpf/agent_uprobe_consumer
bpf/seccomp_confirm

# OS files
.DS_Store
*.swp
*~
